{
  "algorithm": "LNS",
  "data_path": "../../Data/orsm_matrix.csv",
  "locations_path": "../../Data/locations.csv",
  "output_dir": "results",
  
  "constraints": {
    "max_vehicles": 200,
    "vehicle_capacity": 10,
    "default_demand": 1,
    "penalty_unassigned": 1000000,
    "penalty_vehicle_over": 500000
  },

  "lns_parameters": {
    "iterations": 5000,
    "max_runtime": 180,
    "seed": 42,
    
    "destruction_degree": {
      "min": 0.1,
      "max": 0.2
    },
    
    "simulated_annealing": {
      "start_temperature": 1000,
      "end_temperature": 1,
      "step": 0.9995
    }
  },

  "visualization": {
    "osrm_url": "http://localhost:5001",
    "use_osrm": true,
    "map_filename": "lns_route_map.html"
  }
}