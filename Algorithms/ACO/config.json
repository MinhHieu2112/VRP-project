{
  "paths": {
    "distance_matrix": "Data/orsm_matrix.csv",
    "locations_data": "Data/locations.csv",
    "output_dir": "Results"
  },
  "global_constraints": {
    "max_vehicles": 200,
    "vehicle_capacity": 10,
    "default_demand": 1
  },
  "solvers": {
    "aco": {
      "ants_num": 40,
      "max_iter": 1000,
      "no_improve_limit": 100,
      "alpha": 1.0,
      "beta": 2.0,
      "q0": 0.8,
      "rho": 0.1,
      "xi": 0.01,
      "seed_strategy": "clarke_wright",
      "seed_weight": 1.1
    }
  },
  "visualization": {
    "osrm_url": "http://localhost:5001",
    "use_osrm": true,
    "map_filename": "route_map.html"
  }
}