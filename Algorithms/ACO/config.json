{
    "paths": {
        "distance_matrix": "Data/Clean/orsm_matrix_1000.csv",
        "locations_data":  "Data/Clean/locations.csv",
        "output_dir":      "Results"
    },
    "global_constraints": {
        "max_vehicles":     200,
        "vehicle_capacity": 10,
        "default_demand":   1
    },
    "visualization": {
        "osrm_url":     "http://localhost:5001",
        "use_osrm":     true,
        "map_filename": "route_map.html"
    },
    "solvers": {
        "aco": {
            "ants_num":         15,
            "max_iter":         5000,
            "no_improve_limit": 800,  
            "alpha":            1.0,
            "beta":             3.0,   
            "q0":               0.8,  
            "rho":              0.1,
            "xi":               0.1,   
            "seed_strategy":    "greedy",
            "seed_weight":      1.3
        }
    }
}