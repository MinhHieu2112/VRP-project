{
    "paths": {
        "distance_matrix": "Data/orsm_matrix.csv",
        "locations_data":  "Data/locations.csv",
        "output_dir":      "Results"
    },
    "global_constraints": {
        "max_vehicles":    200,
        "vehicle_capacity": 10,
        "default_demand":   1
    },
    "visualization": {
        "osrm_url":     "http://localhost:5001",
        "use_osrm":     true,
        "map_filename": "route_map.html"
    },
    "tabu_parameters": {
        "_comment": "Granular Tabu Search — Toth & Vigo (2003), Gendreau et al. (1994)",
        "_comment_perf": "Tham số được tinh chỉnh cho n<=500. Với n<=200: max_iter~3000, max_no_improve~400.",
        "tabu_size":       20,
        "max_iterations":  10000,
        "max_no_improve":  4000,
        "granular_beta":   1.5,
        "granular_k":      10,
        "penalty_lambda":  1.0,
        "penalty_h":       20,
        "init_strategy":   "random",
        "_init_options":   ["random", "greedy", "clarke_wright"]
    },
    "constraints": {
        "max_vehicles":       200,
        "vehicle_capacity":   10,
        "penalty_unassigned": 1000000
    }
}