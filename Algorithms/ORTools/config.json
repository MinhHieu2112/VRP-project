{
    "project_metadata": {
        "solver": "OR-Tools (Guided Local Search)",
        "description": "Config riêng cho OR-Tools, tuân thủ key schema của Utils/config.json"
    },
    "paths": {
        "distance_matrix": "Data/orsm_matrix.csv",
        "locations_data":  "Data/locations.csv",
        "output_dir":      "Results"
    },
    "common_model_parameters": {
        "num_points": 1600,
        "depot_id":   0
    },
    "global_constraints": {
        "max_vehicles":    200,
        "vehicle_capacity": 10,
        "default_demand":   1
    },
    "visualization": {
        "osrm_url":     "http://localhost:5001",
        "use_osrm":     true,
        "map_filename": "route_map.html"
    },
    "solvers": {
        "or_tools": {
            "first_solution_strategy":    "PATH_CHEAPEST_ARC",
            "local_search_metaheuristic": "GUIDED_LOCAL_SEARCH",
            "no_improve_iters":           200,
            "time_limit":                 200,
            "lns_time_per_step_seconds":  1,
            "log_search":                 false
        }
    }
}