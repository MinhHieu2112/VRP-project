{
    "paths": {
        "distance_matrix": "Data/orsm_matrix.csv",
        "locations": "Data/locations.csv",
        "output_dir": "Results/ORTools"
    },

    "model_parameters": {
        "num_points": 1600,
        "depot_id": 0
    },

    "constraints": {
        "max_vehicles": 200,
        "vehicle_capacity": 10,
        "default_demand": 1
    },

    "solver_parameters": {
        "time_limit": 180,
        "algorithm": "GUIDED LOCAL SEARCH",
        "first_solution_strategy": "PATH_CHEAPEST_ARC"
    },

    "visualization": {
        "osrm_url": "http://localhost:5001",
        "map_filename": "route_map.html"
    }
}