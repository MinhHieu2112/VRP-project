{
    "project_metadata": {
        "name": "ACVRP HCMC Optimization",
        "description": "Unified configuration for ALNS, OR-Tools, and PyVRP solvers"
    },
    "paths": {
        "distance_matrix": "Data/orsm_matrix.csv",
        "locations_data": "Data/locations.csv",
        "output_dir": "Results",
        "log_dir": "logs"
    },
    "common_model_parameters": {
        "num_points": 1600,
        "depot_id": 0
    },
    "global_constraints": {
        "max_vehicles": 200,
        "vehicle_capacity": 10,
        "default_demand": 1,
        "penalty_unassigned": 1000000,
        "penalty_vehicle_over": 500000
    },
    "visualization": {
        "osrm_url": "http://localhost:5001",
        "use_osrm": true,
        "map_filename": "route_map.html",
        "zoom_start": 13
    },
    "solvers": {
        "alns": {
            "max_runtime": 180,
            "start_temperature": 1000,
            "end_temperature": 1,
            "step": 0.9997,
            "scores": [10, 5, 2, 0],
            "decay": 0.8
        },
        "or_tools": {
            "time_limit_seconds": 180,
            "first_solution_strategy": "LOCAL_CHEAPEST_INSERTION",
            "local_search_metaheuristic": "GUIDED_LOCAL_SEARCH",
            "display_log": true
        },
        "py_vrp": {
            "time_limit_seconds": 180,
            "display_log": true,
            "result_file": "pyvrp_result.txt"
        }
    }
}